# Supabase project URL. Local default: http://127.0.0.1:54321.
# For phones/laptops, use a separate hosted demo project URL; never expose the local stack.
VITE_SUPABASE_URL=

# Browser-safe anon key reported by `npx supabase status`.
VITE_SUPABASE_ANON_KEY=

# Deployment environment label: local, staging, production.
VITE_APP_ENV=local

# QA only. Keep empty in source control. Required for hosted smoke tests;
# local smoke tests use the fictitious password from supabase/seed.sql.
SUPABASE_QA_PASSWORD=
SUPABASE_QA_ADMIN_EMAIL=
SUPABASE_QA_TECH_EMAIL=
SUPABASE_QA_PROFESSIONAL_EMAIL=
SUPABASE_QA_OTHER_TENANT_EMAIL=
SUPABASE_QA_SUSPENDED_EMAIL=
SUPABASE_QA_NO_ORG_EMAIL=

# Set true only in a disposable local/demo environment. It uploads a 1px QA image.
SUPABASE_QA_ALLOW_STORAGE_MUTATIONS=false

# Override only if the local Supabase DB container uses another name.
SUPABASE_DB_CONTAINER=supabase_db_retinacare-beta
